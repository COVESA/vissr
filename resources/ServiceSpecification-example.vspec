# The service tree example builds on input from the Capabilities project:
# https://covesa.atlassian.net/wiki/spaces/WIK4/pages/39059848/Capabilities+Project+-+Seating+Capabilities#CapabilitiesProject-SeatingCapabilities-InformationTypes
#
# MoveSeat and ActivateMassage manage multiple resources (one per seat) and
# are therefore declared with 'instances' directly on the procedure node,
# per the HIM Service Rule Set's "multiplexed microservice tree structure":
# https://covesa.github.io/hierarchical_information_model/service_rule_set/basics/#multiplexed-microservice-tree-structure
# Each resource instance (e.g. Row1.DriverSide) is a plain 'branch' nested
# under the single, stable procedure path (e.g.
# VehicleService.Seating.MoveSeat) and carries its own Input/Output
# iostructs. A client addresses a specific seat (or several, or all) via the
# VISSv3.2 Services "resource" filter variant on that one stable path,
# rather than by addressing 12 separately duplicated procedure paths.
#
# GetCapabilities is not multiplexed: it returns the capability tokens for
# the service group as a whole, not per seat, so it has no 'instances'.

VehicleService:
  type: branch
  description: The Vehicle services.

VehicleService.Seating:
  type: branch
  description: The Seating service group.

VehicleService.Seating.MoveSeat:
  type: procedure
  instances:
    - Row[1,2]
    - ["DriverSide","PassengerSide"]
  description: Performs all supported seat movements.

VehicleService.Seating.MoveSeat.Input:
  type: iostruct
  description:  Input parameters= (MovementType, Position, Credentials).

VehicleService.Seating.MoveSeat.Input.MovementType:
  type: property
  datatype: string
  description: Type of movement. Supported types are retrieved via GetCapabilities().

VehicleService.Seating.MoveSeat.Input.Position:
  type: property
  datatype: Types.Common.Percentage
  description: Final position of the movement, expressed as a percentage.

VehicleService.Seating.MoveSeat.Input.Credentials:
  type: property
  datatype: string
  description: A token with client credentials. Optional parameter.

VehicleService.Seating.MoveSeat.Output:
  type: iostruct
  description:  Output parameters= (Status, Position, ServiceId).

VehicleService.Seating.MoveSeat.Output.Status:
  type: property
  datatype: Types.Common.Service.Status
  description: Status of the MoveSeat service.

VehicleService.Seating.MoveSeat.Output.Position:
  type: property
  datatype: Types.Common.Percentage
  description: Final position of the movement, expressed as a percentage.

VehicleService.Seating.MoveSeat.Output.ServiceId:
  type: property
  datatype: uint32
  description: A reference to the service execution session.

VehicleService.Seating.MoveSeat.Version:
  type: attribute
  datatype: string
  default: 1.0.0
  instantiate: false
  description: The MoveSeat service version. Not instantiated per resource.

VehicleService.Seating.ActivateMassage:
  type: procedure
  instances:
    - Row[1,2]
    - ["DriverSide","PassengerSide"]
  description: Performs all supported seat massage.

VehicleService.Seating.ActivateMassage.Input:
  type: iostruct
  description:  Input parameters= (MassageType, Duration, Credentials).

VehicleService.Seating.ActivateMassage.Input.MassageType:
  type: property
  datatype: string
  description: Type of massage. Supported types are retrieved via GetCapabilities().

VehicleService.Seating.ActivateMassage.Input.Duration:
  type: property
  datatype: uint32
  description: Duration of massage session in seconds.

VehicleService.Seating.ActivateMassage.Input.Credentials:
  type: property
  datatype: string
  description: A token with client credentials. Optional parameter.

VehicleService.Seating.ActivateMassage.Output:
  type: iostruct
  description:  Output parameters= (Status, ServiceId).

VehicleService.Seating.ActivateMassage.Output.Status:
  type: property
  datatype: Types.Common.Service.Status
  description: Status of the ActivateMassage service.

VehicleService.Seating.ActivateMassage.Output.ServiceId:
  type: property
  datatype: uint32
  description: A reference to the service execution session.

VehicleService.Seating.ActivateMassage.Version:
  type: attribute
  datatype: string
  default: 1.0.0
  instantiate: false
  description: The ActivateMassage service version. Not instantiated per resource.

VehicleService.Seating.GetCapabilities:
  type: procedure
  description:  Get the tokens representing supported seat capabilities. Not multiplexed - applies to the whole Seating service group.

VehicleService.Seating.GetCapabilities.Output:
  type: iostruct
  description:  Output parameters= (Status, Capabilities[]).

VehicleService.Seating.GetCapabilities.Output.Status:
  type: property
  datatype: Types.Common.Service.Status
  description: Status of the GetCapabilities service.

VehicleService.Seating.GetCapabilities.Output.Capabilities:
  type: property
  datatype: Types.Struct.Service.Capability[]
  description: Array member contains definition of a capability.

VehicleService.Seating.GetCapabilities.Version:
  type: attribute
  datatype: string
  default: 1.0.0
  description: The GetCapabilities service version.
